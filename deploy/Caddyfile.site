# Блок сайта для стенда «Резонанс». Единственный шаблон конфигурации Caddy:
# ./deploy/configure.sh собирает из него два файла в deploy/local/ —
# отдельный Caddyfile (если Caddy на машине больше ничем не занят) и вставку
# verdict-causa.caddy (если Caddy уже обслуживает другие сайты).
#
# Приложение слушает только 127.0.0.1: наружу его выпускает этот блок, он же
# получает и продлевает сертификат. Базовая аутентификация здесь не украшение —
# в приложении аутентификации нет вовсе, и без неё открытый адрес означает, что
# любой желающий видит дела и может загружать файлы.

stand.example.com {
	# Почта для Let's Encrypt задана внутри блока, а не в глобальных настройках:
	# иначе вставку нельзя было бы подключить к чужому Caddyfile, у которого свой
	# глобальный блок.
	tls you@example.com

	basic_auth {
		# Строку ниже подставляет ./deploy/configure.sh: он спросит пароль,
		# не покажет его на экране и запишет сюда только bcrypt-хэш.
		operator ЗАМЕНИТЕ_НА_ХЭШ
	}

	reverse_proxy 127.0.0.1:8765 {
		# Сборка стола занимает несколько секунд, а пересчёт дела после
		# загрузки документа — ещё столько же: короткий таймаут оборвал бы
		# ровно то, ради чего стенд ставится.
		transport http {
			response_header_timeout 120s
		}
	}

	encode gzip

	header {
		# Стенд не предназначен для встраивания и не должен индексироваться.
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Robots-Tag "noindex, nofollow"
	}

	log {
		output file /var/log/caddy/verdict-causa.log
	}
}
