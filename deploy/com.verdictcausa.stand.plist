<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.verdictcausa.stand</string>

	<key>ProgramArguments</key>
	<array>
		<string>/Users/ВАШ_ПОЛЬЗОВАТЕЛЬ/verdict-causa/.venv/bin/python</string>
		<string>-m</string>
		<string>causa.ui.server</string>
	</array>

	<key>WorkingDirectory</key>
	<string>/Users/ВАШ_ПОЛЬЗОВАТЕЛЬ/verdict-causa</string>

	<key>EnvironmentVariables</key>
	<dict>
		<!-- Только локальный адрес: наружу выпускает Caddy. -->
		<key>CAUSA_UI_HOST</key>
		<string>127.0.0.1</string>
		<key>CAUSA_UI_PORT</key>
		<string>ПОРТ_СТЕНДА</string>
		<key>PYTHONUNBUFFERED</key>
		<string>1</string>
	</dict>

	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>

	<key>StandardOutPath</key>
	<string>/Users/ВАШ_ПОЛЬЗОВАТЕЛЬ/Library/Logs/verdict-causa-stand.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/ВАШ_ПОЛЬЗОВАТЕЛЬ/Library/Logs/verdict-causa-stand-error.log</string>
</dict>
</plist>
